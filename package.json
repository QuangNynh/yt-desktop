{
  "name": "youtube-scheduler-desktop",
  "version": "1.0.0",
  "description": "YouTube Bulk Scheduler Desktop Application",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "Quang Ny",
  "scripts": {
    "dev:backend": "cross-env PORT=8695 tsx watch backend/src/server.ts",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:8695 tcp:8696 && tsc -p tsconfig.electron.json && electron dist-electron/main.js",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win --x64",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.562.0",
    "multer": "^1.4.5-lts.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
